server {
    listen 8080;
    server_name _;

    root  /usr/share/nginx/html;
    index index.html;

    # Forward API calls to the Go backend.
    # The trailing slash on proxy_pass strips the /api prefix:
    #   /api/projects  ->  http://backend:8080/projects
    location /api/ {
        proxy_pass http://${BACKEND_URL}/;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # React handles its own routes (/projects/3 etc.) in the browser.
    # If no file matches, send index.html and let React decide.
    location / {
        try_files $uri $uri/ /index.html;
    }
}
